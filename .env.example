ADDR=:8080
API_PORT=8099
POSTGRES_PORT=5433
# DATABASE_URL so vale para rodar o daemon fora do docker (go run ./cmd/tilapou serve)
DATABASE_URL=postgres://tilapou:tilapou@localhost:5433/tilapou?sslmode=disable
LOG_LEVEL=info
DB_MAX_CONNS=10
DB_TIMEOUT=3s
REQUEST_TIMEOUT=30s
TRUSTED_PROXIES=0
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s
